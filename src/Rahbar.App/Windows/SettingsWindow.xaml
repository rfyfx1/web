<Window x:Class="Rahbar.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rahbar.App.Windows"
        Title="Rahbar – Settings" Width="620" Height="760" MinWidth="520"
        WindowStartupLocation="CenterScreen" Icon="/Assets/rahbar.ico" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,10" Background="#F3F4F6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="0" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,6,20,20">

                <TextBlock Text="Language" Style="{StaticResource Heading}" />
                <ComboBox x:Name="LanguageBox" DisplayMemberPath="DisplayName" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Speak in any language: English, Urdu, Roman Urdu, Hindi, Hinglish, or a mix. 'Auto' answers in the same language and style you used. Pick a fixed option if you always want answers in one style." />

                <TextBlock Text="AI brain (looks at your screen)" Style="{StaticResource Heading}" />
                <ComboBox x:Name="BrainBox" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="gemini" Content="Google Gemini – free tier (recommended)" />
                    <ComboBoxItem Tag="claude" Content="Anthropic Claude – paid, most accurate pointing" />
                    <ComboBoxItem Tag="ollama" Content="Ollama – runs on this PC, private (needs a good GPU)" />
                </ComboBox>

                <GroupBox Header="Gemini" Margin="0,10,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="API key" />
                        <PasswordBox x:Name="GeminiKey" Padding="4" />
                        <TextBlock Style="{StaticResource Hint}">
                            <Hyperlink Click="GeminiLink_Click">Get a free key at aistudio.google.com/apikey</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Model" />
                        <TextBox x:Name="GeminiModel" Padding="4" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="GeminiTest" Content="Test" Click="GeminiTest_Click" />
                            <TextBlock x:Name="GeminiResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Claude" Margin="0,10,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="API key" />
                        <PasswordBox x:Name="ClaudeKey" Padding="4" />
                        <TextBlock Style="{StaticResource Hint}">
                            <Hyperlink Click="ClaudeLink_Click">Get a key at console.anthropic.com</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Model" />
                        <TextBox x:Name="ClaudeModel" Padding="4" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ClaudeTest" Content="Test" Click="ClaudeTest_Click" />
                            <TextBlock x:Name="ClaudeResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Ollama (local)" Margin="0,10,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Address" />
                        <TextBox x:Name="OllamaUrl" Padding="4" />
                        <TextBlock Text="Model" Margin="0,6,0,0" />
                        <TextBox x:Name="OllamaModel" Padding="4" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="OllamaTest" Content="Test" Click="OllamaTest_Click" />
                            <TextBlock x:Name="OllamaResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Voice in (speech to text)" Style="{StaticResource Heading}" />
                <ComboBox x:Name="SttBox" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="groq" Content="Groq Whisper – free tier, best for Urdu / Hindi / mixed (recommended)" />
                    <ComboBoxItem Tag="windows" Content="Windows speech recognition – offline, English only" />
                </ComboBox>
                <GroupBox Header="Groq" Margin="0,10,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="API key" />
                        <PasswordBox x:Name="GroqKey" Padding="4" />
                        <TextBlock Style="{StaticResource Hint}">
                            <Hyperlink Click="GroqLink_Click">Get a free key at console.groq.com/keys</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Model" />
                        <TextBox x:Name="GroqModel" Padding="4" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="GroqTest" Content="Test" Click="GroqTest_Click" />
                            <TextBlock x:Name="GroqResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Voice out" Style="{StaticResource Heading}" />
                <ComboBox x:Name="VoiceBox" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="'Automatic' picks a voice that matches each answer's language. For Urdu or Hindi voices, add the language in Windows Settings › Time &amp; language › Language &amp; region and tick 'Speech'." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="RateSlider" Minimum="0.6" Maximum="1.6" Width="200" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <Button Content="Test voice" Click="VoiceTest_Click" Margin="12,0,0,0" />
                </StackPanel>

                <TextBlock Text="Hotkeys" Style="{StaticResource Heading}" />
                <TextBlock Text="Ask by voice (hold)" />
                <local:HotkeyBox x:Name="HotkeyInput" />
                <TextBlock Text="Type a question (tap)" Margin="0,8,0,0" />
                <local:HotkeyBox x:Name="TypedHotkeyInput" />
                <TextBlock Text="Dictation: types what you say into the text box you're in (hold)" Margin="0,8,0,0" />
                <local:HotkeyBox x:Name="DictationHotkeyInput" />
                <TextBlock Style="{StaticResource Hint}" Text="Click a box, then press the keys. Each hotkey must be different. Esc always stops Rahbar." />

                <TextBlock Text="Walkthroughs" Style="{StaticResource Heading}" />
                <CheckBox x:Name="ClickAdvanceBox" Content="Go to the next step when I click the highlighted button" />
                <CheckBox x:Name="FreshShotBox" Content="Look at the screen again for every step (more accurate, a little slower)" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Hint}" Text="During a walkthrough, say &quot;next&quot;, &quot;agla&quot; or &quot;ho gaya&quot; (hold the hotkey), click Next, or click the highlighted button. Say &quot;back&quot; / &quot;pichla&quot;, &quot;dobara&quot; to repeat, &quot;bas&quot; to stop." />

                <TextBlock Text="Updates" Style="{StaticResource Heading}" />
                <TextBox x:Name="UpdateUrlBox" Padding="4" />
                <TextBlock Style="{StaticResource Hint}" Text="Where new versions are published (a GitHub repository address or a shared folder). Leave empty if unsure." />

                <TextBlock Text="Privacy" Style="{StaticResource Heading}" />
                <CheckBox x:Name="PrivateBox" Content="Private mode: use only Ollama and offline speech (nothing leaves this PC)" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Free-tier AI providers may use your requests to improve their models. Don't use free mode on screens with private data (passwords, bank details, customer info); use Private mode instead. Rahbar only takes a screenshot when you hold the hotkey." />
                <CheckBox x:Name="DebugBox" Content="Debug mode (saves screenshots and answers in the log folder)" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
